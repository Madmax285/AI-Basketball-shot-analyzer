
{
  "entities": {
    "AnalysisSession": {
      "title": "AnalysisSession",
      "type": "object",
      "description": "A comprehensive video analysis session.",
      "properties": {
        "id": { "type": "string" },
        "filename": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "status": { "type": "string", "enum": ["processing", "completed", "failed"] },
        "overallScore": { "type": "number" },
        "processedVideoUrl": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "filename", "status", "userId"]
    },
    "ShotResult": {
      "title": "ShotResult",
      "type": "object",
      "description": "Detailed analysis for an individual action detected in a video.",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "shotNumber": { "type": "number" },
        "actionType": { "type": "string" },
        "confidence": { "type": "number" },
        "result": { "type": "string" },
        "location": { "type": "string" },
        "playStatus": { "type": "string" },
        "timestamp": { "type": "number" },
        "overallScore": { "type": "number" },
        "metrics": { "type": "object" },
        "foulAnalysis": { "type": "object" },
        "violationAnalysis": { "type": "object" }
      },
      "required": ["id", "sessionId", "shotNumber", "actionType"]
    },
    "DetectedEvent": {
      "title": "DetectedEvent",
      "type": "object",
      "description": "Specific temporal event on the video timeline.",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "timestamp": { "type": "number" },
        "eventType": { "type": "string" },
        "label": { "type": "string" },
        "confidence": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "analysisSessions": {
      "schema": { "$ref": "#/backend/entities/AnalysisSession" },
      "description": "Video analysis session metadata."
    },
    "shotResults": {
      "schema": { "$ref": "#/backend/entities/ShotResult" },
      "description": "Individual shot/action data points."
    },
    "detectedEvents": {
      "schema": { "$ref": "#/backend/entities/DetectedEvent" },
      "description": "Timeline events for interactive video control."
    }
  }
}
