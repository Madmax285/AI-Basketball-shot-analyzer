
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "System user profile with role-based permissions.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "SALES_USER", "LOGISTICS_USER"] }
      },
      "required": ["id", "email", "role"]
    },
    "Customer": {
      "title": "Customer",
      "type": "object",
      "description": "Enterprise customer master record.",
      "properties": {
        "id": { "type": "string", "description": "CUST1001 format" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "status"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Product catalog with stock management.",
      "properties": {
        "id": { "type": "string", "description": "PROD1001 format" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "unitPrice": { "type": "number" },
        "availableStock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["IN STOCK", "LOW STOCK"] }
      },
      "required": ["id", "name", "unitPrice", "availableStock"]
    },
    "SalesOrder": {
      "title": "SalesOrder",
      "type": "object",
      "description": "Sales document recording a customer's purchase.",
      "properties": {
        "id": { "type": "string", "description": "SO1001 format" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "orderDate": { "type": "string", "format": "date-time" },
        "requestedDeliveryDate": { "type": "string", "format": "date-time" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["NEW", "CONFIRMED", "PROCESSING", "PARTIALLY_DELIVERED", "COMPLETED", "CANCELLED"] }
      },
      "required": ["id", "customerId", "orderDate", "totalAmount", "status"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "type": "object",
      "description": "Individual line items within a sales order.",
      "properties": {
        "id": { "type": "string" },
        "salesOrderId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" }
      },
      "required": ["id", "salesOrderId", "productId", "quantity"]
    },
    "Delivery": {
      "title": "Delivery",
      "type": "object",
      "description": "Logistics document for order fulfillment.",
      "properties": {
        "id": { "type": "string", "description": "DEL1001 format" },
        "salesOrderId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "expectedDeliveryDate": { "type": "string", "format": "date-time" },
        "actualDeliveryDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"] }
      },
      "required": ["id", "salesOrderId", "status"]
    },
    "Shipment": {
      "title": "Shipment",
      "type": "object",
      "description": "Transport grouping for bulk fulfillment.",
      "properties": {
        "id": { "type": "string", "description": "SHIP1001 format" },
        "deliveryId": { "type": "string" },
        "salesOrderId": { "type": "string" },
        "carrier": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["READY", "PICKED_UP", "IN_TRANSIT", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED"] }
      },
      "required": ["id", "deliveryId", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles with roles."
    },
    "customers": {
      "schema": { "$ref": "#/backend/entities/Customer" },
      "description": "Customer master records."
    },
    "products": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Product catalog records."
    },
    "salesOrders": {
      "schema": { "$ref": "#/backend/entities/SalesOrder" },
      "description": "Transactional sales orders."
    },
    "orderItems": {
      "schema": { "$ref": "#/backend/entities/OrderItem" },
      "description": "Sales order line items."
    },
    "deliveries": {
      "schema": { "$ref": "#/backend/entities/Delivery" },
      "description": "Order fulfillment records."
    },
    "shipments": {
      "schema": { "$ref": "#/backend/entities/Shipment" },
      "description": "Logistics shipment records."
    }
  }
}
