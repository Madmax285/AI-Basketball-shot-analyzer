
{
  "entities": {
    "AnalysisSession": {
      "title": "AnalysisSession",
      "type": "object",
      "description": "A video analysis session for a basketball player.",
      "properties": {
        "id": { "type": "string" },
        "filename": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "status": { "type": "string", "enum": ["processing", "completed", "failed"] },
        "overallScore": { "type": "number" },
        "processedVideoUrl": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "filename", "status", "userId"]
    },
    "ShotResult": {
      "title": "ShotResult",
      "type": "object",
      "description": "Detailed mechanics for an individual shot detected in a session.",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "shotNumber": { "type": "number" },
        "overallScore": { "type": "number" },
        "lowerBodyScore": { "type": "number" },
        "upperBodyScore": { "type": "number" },
        "alignmentScore": { "type": "number" },
        "releaseScore": { "type": "number" },
        "consistencyScore": { "type": "number" },
        "metrics": { "type": "object" },
        "phases": { "type": "object" }
      },
      "required": ["id", "sessionId", "shotNumber"]
    },
    "FormIssue": {
      "title": "FormIssue",
      "type": "object",
      "description": "A specific form issue detected during a shot.",
      "properties": {
        "id": { "type": "string" },
        "shotId": { "type": "string" },
        "issue": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "metric": { "type": "string" },
        "value": { "type": "number" },
        "recommendation": { "type": "string" }
      },
      "required": ["id", "shotId", "issue", "severity", "recommendation"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "analysisSessions": {
      "schema": { "$ref": "#/backend/entities/AnalysisSession" },
      "description": "User video analysis sessions."
    },
    "shotResults": {
      "schema": { "$ref": "#/backend/entities/ShotResult" },
      "description": "Individual shot data points."
    },
    "formIssues": {
      "schema": { "$ref": "#/backend/entities/FormIssue" },
      "description": "Recommendations for players."
    }
  }
}
