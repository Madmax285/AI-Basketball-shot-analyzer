
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "System user profile.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Sales", "Logistics"] }
      },
      "required": ["id", "email"]
    },
    "Customer": {
      "title": "Customer",
      "type": "object",
      "description": "Enterprise customer profile.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["id", "name", "email", "status"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Product catalog item.",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["id", "sku", "name", "price", "stock"]
    },
    "SalesOrder": {
      "title": "SalesOrder",
      "type": "object",
      "description": "Sales document recording a customer's purchase.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "orderDate": { "type": "string", "format": "date-time" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Confirmed", "Shipped", "Delivered", "Cancelled"] }
      },
      "required": ["id", "customerId", "orderDate", "totalAmount", "status"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "type": "object",
      "description": "Individual items within a sales order.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" }
      },
      "required": ["id", "orderId", "productId", "quantity"]
    },
    "Delivery": {
      "title": "Delivery",
      "type": "object",
      "description": "Logistics document for order fulfillment.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "deliveryDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "In Transit", "Delivered", "Returned"] },
        "carrier": { "type": "string" },
        "trackingNumber": { "type": "string" }
      },
      "required": ["id", "orderId", "status"]
    },
    "Shipment": {
      "title": "Shipment",
      "type": "object",
      "description": "Consolidated transport groupings.",
      "properties": {
        "id": { "type": "string" },
        "departureDate": { "type": "string", "format": "date-time" },
        "arrivalDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Planned", "Loaded", "Departed", "Arrived"] },
        "vehicleId": { "type": "string" }
      },
      "required": ["id", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "System user profiles."
    },
    "customers": {
      "schema": { "$ref": "#/backend/entities/Customer" },
      "description": "Global customer records."
    },
    "products": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Product master data."
    },
    "salesOrders": {
      "schema": { "$ref": "#/backend/entities/SalesOrder" },
      "description": "Transactional sales orders."
    },
    "orderItems": {
      "schema": { "$ref": "#/backend/entities/OrderItem" },
      "description": "Detailed order items."
    },
    "deliveries": {
      "schema": { "$ref": "#/backend/entities/Delivery" },
      "description": "Logistics delivery tracking."
    },
    "shipments": {
      "schema": { "$ref": "#/backend/entities/Shipment" },
      "description": "Consolidated shipments."
    }
  }
}
