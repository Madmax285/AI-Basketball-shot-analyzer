
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check roles
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return request.auth != null && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('ADMIN');
    }
    
    function isSales() {
      return hasRole('SALES_USER') || isAdmin();
    }
    
    function isLogistics() {
      return hasRole('LOGISTICS_USER') || isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if request.auth != null;
      allow write: if isSales();
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isSales() || isLogistics();
    }

    match /salesOrders/{orderId} {
      allow read: if request.auth != null;
      allow write: if isSales();
    }
    
    match /orderItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if isSales();
    }

    match /deliveries/{deliveryId} {
      allow read: if request.auth != null;
      allow write: if isLogistics();
    }

    match /shipments/{shipmentId} {
      allow read: if request.auth != null;
      allow write: if isLogistics();
    }
  }
}
