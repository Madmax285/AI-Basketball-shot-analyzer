rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Checks if the user requesting the data is the owner of the document.
     * Works for both single-doc 'get' and collection-wide 'list' queries
     * when the query is filtered by userId.
     */
    function isOwner(data) {
      return isAuthenticated()
        && data.get('userId', '') == request.auth.uid;
    }

    // =========================================================
    // USER-CENTRIC COLLECTIONS
    // =========================================================

    // Analysis Sessions, Shot Results, and Detected Events follow the same ownership logic
    match /analysisSessions/{sessionId} {
      allow read: if isOwner(resource.data);
      
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isOwner(resource.data);
    }

    match /shotResults/{shotId} {
      allow read: if isOwner(resource.data);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isOwner(resource.data);
    }

    match /detectedEvents/{eventId} {
      allow read: if isOwner(resource.data);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isOwner(resource.data);
    }

    // =========================================================
    // SYSTEM METADATA
    // =========================================================

    match /system/{document=**} {
      // Allow read/write for any authenticated user to enable demo data seeding and global metadata.
      allow read, write: if isAuthenticated();
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
