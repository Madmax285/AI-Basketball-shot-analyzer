rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Ownership Rules (v1.3.2)
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the document
    // Used for both 'get' (single doc) and 'list' (queries)
    function isOwner(data) {
      return isAuthenticated() && data != null && data.userId == request.auth.uid;
    }

    // Rules for Analysis Sessions
    match /analysisSessions/{sessionId} {
      // Direct ownership check is most reliable for rules engine verification
      allow read: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Individual Shot Results
    match /shotResults/{shotId} {
      allow read: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Detected Events
    match /detectedEvents/{eventId} {
      allow read: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // System metadata
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    // Final default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}