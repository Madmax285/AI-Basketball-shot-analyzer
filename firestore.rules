rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Analyzer - Production Security Rules (v1.3.8)
    
    // Helper to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to verify document ownership
    function isOwner(data) {
      return isAuthenticated() && data.get('userId', '') == request.auth.uid;
    }

    match /analysisSessions/{sessionId} {
      // Allow list if the query is filtered by userId
      allow list: if isAuthenticated() && request.query.limit <= 100;
      // Allow get if the document belongs to the user or doesn't exist yet
      allow get: if isAuthenticated() && (resource == null || isOwner(resource.data));
      // Allow creation only if the user stamps their own UID
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow updates/deletes only for owners
      allow update, delete: if isOwner(resource.data);
    }
    
    match /shotResults/{shotId} {
      allow list: if isAuthenticated() && request.query.limit <= 500;
      allow get: if isAuthenticated() && (resource == null || isOwner(resource.data));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    match /detectedEvents/{eventId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource == null || isOwner(resource.data));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // System metadata for demo seeding and app configuration
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }
    
    // Explicitly deny all other access to keep the database lean and secure
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
