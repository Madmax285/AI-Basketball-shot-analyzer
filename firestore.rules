rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Ownership Rules (v1.2.9)
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the document
    function isOwner(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    // Rules for Analysis Sessions
    match /analysisSessions/{sessionId} {
      // Allow list queries filtered by current userId
      allow list: if isAuthenticated() && request.auth.uid == request.query.userId;
      allow get: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Individual Shot Results
    match /shotResults/{shotId} {
      // Allow list queries filtered by current userId
      allow list: if isAuthenticated() && request.auth.uid == request.query.userId;
      allow get: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Detected Events
    match /detectedEvents/{eventId} {
      allow list: if isAuthenticated() && request.auth.uid == request.query.userId;
      allow get: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // System metadata
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    // Final default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
