
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Analyzer Collections
    
    // Allow public read/write for analysis sessions
    match /analysisSessions/{sessionId} {
      allow read, write: if true;
    }

    // Allow public read/write for individual shot results
    match /shotResults/{shotId} {
      allow read, write: if true;
    }

    // Allow public read/write for form issues/recommendations
    match /formIssues/{issueId} {
      allow read, write: if true;
    }

    // Rules for system metadata (e.g., used for state or initialization)
    match /system/{docId} {
      allow read, write: if true;
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
