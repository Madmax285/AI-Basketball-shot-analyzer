
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Analyzer - Public Access Rules
    // These rules allow unauthenticated users to view and create analysis data
    // supporting the frictionless "Direct Access" model.
    
    // Deployment Trigger: Final permission fix for shotResults and multi-event timeline
    // Version: 1.0.4

    // Allow public read/write for all primary analysis collections
    // Using {document=**} to ensure that both document gets and collection lists are covered
    
    match /analysisSessions/{document=**} {
      allow read, write: if true;
    }

    match /shotResults/{document=**} {
      allow read, write: if true;
    }

    match /detectedEvents/{document=**} {
      allow read, write: if true;
    }

    match /formIssues/{document=**} {
      allow read, write: if true;
    }

    // Rules for system metadata
    match /system/{docId} {
      allow read, write: if true;
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
