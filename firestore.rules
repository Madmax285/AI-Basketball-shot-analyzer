rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Ownership Rules (v1.3.5)
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user owns the document data
    // Uses .get() to handle cases where userId might be missing in legacy data
    function isOwner(data) {
      return isAuthenticated() && data.get('userId', '') == request.auth.uid;
    }

    // Rules for Analysis Sessions
    match /analysisSessions/{sessionId} {
      // allow get: for single document reads (requires ownership)
      // allow list: for collection queries (requires ownership filter in frontend)
      allow read: if isOwner(resource.data);
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
                    
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Individual Shot Results
    match /shotResults/{shotId} {
      allow read: if isOwner(resource.data);
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
                    
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Detected Events
    match /detectedEvents/{eventId} {
      allow read: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // System metadata
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    // Final default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}