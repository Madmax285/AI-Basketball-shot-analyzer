
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Public Access Rules
    // Version: 1.0.6 (Permissions Refresh)
    
    // Allow unauthenticated read/write for all primary data collections
    // This supports the frictionless "Direct Access" model requested for athletes.

    match /analysisSessions/{document=**} {
      allow read, write: if true;
    }

    match /shotResults/{document=**} {
      allow read, write: if true;
    }

    match /detectedEvents/{document=**} {
      allow read, write: if true;
    }

    match /formIssues/{document=**} {
      allow read, write: if true;
    }

    match /system/{document=**} {
      allow read, write: if true;
    }
    
    // Default deny for all other paths to maintain system integrity
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
