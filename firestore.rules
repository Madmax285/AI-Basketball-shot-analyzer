rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Public Access Rules
    // Explicitly allow read/write for all primary data collections to support the direct-access model.
    
    match /analysisSessions/{document=**} {
      allow read, write: if true;
    }
    
    match /shotResults/{document=**} {
      allow read, write: if true;
    }
    
    match /detectedEvents/{document=**} {
      allow read, write: if true;
    }
    
    match /system/{document=**} {
      allow read, write: if true;
    }
    
    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}