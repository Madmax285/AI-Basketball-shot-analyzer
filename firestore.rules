
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Analyzer - Public Access Rules
    // These rules allow unauthenticated users to view and create analysis data
    // to support the frictionless "Direct Access" model requested for this project.
    
    // Deployment Trigger: Updated rules for Shot Intelligence Pipeline
    
    // Allow public read/write for analysis sessions
    match /analysisSessions/{sessionId} {
      allow read, write: if true;
    }

    // Allow public read/write for individual shot results
    match /shotResults/{shotId} {
      allow read, write: if true;
    }

    // Allow public read/write for timeline events
    match /detectedEvents/{eventId} {
      allow read, write: if true;
    }

    // Allow public read/write for form issues/recommendations
    match /formIssues/{issueId} {
      allow read, write: if true;
    }

    // Rules for system metadata
    match /system/{docId} {
      allow read, write: if true;
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
