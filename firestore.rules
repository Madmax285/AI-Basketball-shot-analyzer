rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Ownership Rules (v1.3.3)
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for Analysis Sessions
    match /analysisSessions/{sessionId} {
      // Allow read if the document belongs to the user or if it's being queried by the owner
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Rules for Individual Shot Results
    match /shotResults/{shotId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Rules for Detected Events
    match /detectedEvents/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // System metadata
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    // Final default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}