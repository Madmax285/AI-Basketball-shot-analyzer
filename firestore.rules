rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Public Access Rules (v1.1.0)
    // This allows unauthenticated users to use the analyzer and view results.
    
    match /analysisSessions/{document=**} {
      allow read, write: if true;
    }
    
    match /shotResults/{document=**} {
      allow read, write: if true;
    }
    
    match /detectedEvents/{document=**} {
      allow read, write: if true;
    }
    
    match /system/{document=**} {
      allow read, write: if true;
    }
    
    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
