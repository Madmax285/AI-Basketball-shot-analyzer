rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Secure Ownership Rules (v1.2.2)
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if user owns the document via a data field
    function isOwner(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    match /analysisSessions/{sessionId} {
      // Allow individual lookups and filtered queries
      allow get: if isOwner(resource.data);
      allow list: if isAuthenticated() && request.query.limit <= 100 && request.auth.uid == request.resource.data.userId;
      
      // Ownership enforcement for writes
      allow create: if isOwner(request.resource.data);
      allow update, delete: if isOwner(resource.data);
    }
    
    match /shotResults/{shotId} {
      // Explicitly allow list operations where the query matches the userId filter
      allow get: if isOwner(resource.data);
      allow list: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      
      allow create: if isOwner(request.resource.data);
      allow update, delete: if isOwner(resource.data);
    }
    
    match /detectedEvents/{eventId} {
      allow get: if isOwner(resource.data);
      allow list: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      
      allow create: if isOwner(request.resource.data);
      allow update, delete: if isOwner(resource.data);
    }
    
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}