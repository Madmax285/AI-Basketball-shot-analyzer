rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Ownership Rules (v1.3.6)
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user owns the document data
    function isOwner(data) {
      return isAuthenticated() && data.get('userId', '') == request.auth.uid;
    }

    // Rules for Analysis Sessions
    match /analysisSessions/{sessionId} {
      // allow read: handles both single get and collection queries
      // For queries, the userId filter must be applied in the frontend.
      allow read: if isOwner(resource.data);
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
                    
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Individual Shot Results
    match /shotResults/{shotId} {
      allow read: if isOwner(resource.data);
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
                    
      allow update, delete: if isOwner(resource.data);
    }
    
    // Rules for Detected Events
    match /detectedEvents/{eventId} {
      allow read: if isOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    // System metadata - allow write for demo data initialization
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }
    
    // Final default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}