rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Analyzer - Explicit Ownership Rules (v1.3.7)
    
    match /analysisSessions/{sessionId} {
      // Direct ownership check for reads and writes
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /shotResults/{shotId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /detectedEvents/{eventId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // System metadata for demo seeding
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; 
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}