rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ERP PROTOTYPE RULES
     * These rules allow public access to the enterprise data entities.
     * This is intended for a prototype environment where the login barrier has been removed.
     */

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /salesOrders/{orderId} {
      allow read, write: if true;
    }

    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }

    match /shipments/{shipmentId} {
      allow read, write: if true;
    }
    
    // Legacy collections (if still present in database)
    match /volunteers/{volunteerId} {
      allow read, write: if true;
    }
    
    match /missions/{missionId} {
      allow read, write: if true;
    }
    
    match /missionVolunteerMatches/{matchId} {
      allow read, write: if true;
    }
  }
}