rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Secure Ownership Rules (v1.2.5)
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if user owns the document (used for single document reads and writes)
    function isOwner(userId) {
      return isAuthenticated() && userId == request.auth.uid;
    }

    match /analysisSessions/{sessionId} {
      // Allow single document get if owned by the user
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow collection listing if every document matches the user's UID (required for query filtering)
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Enforce ownership on creation
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Enforce ownership on updates and deletes
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /shotResults/{shotId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /detectedEvents/{eventId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}