rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basketball AI Video Analyzer - Secure Ownership Rules (v1.2.3)
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if user owns the document via a data field
    function isOwner(data) {
      return isAuthenticated() && data != null && data.userId == request.auth.uid;
    }

    match /analysisSessions/{sessionId} {
      // Allow getting a specific session if owned by the user
      allow get: if isOwner(resource.data);
      
      // Allow listing sessions filtered by the user's UID
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Enforce ownership on creation and updates
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    match /shotResults/{shotId} {
      allow get: if isOwner(resource.data);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    match /detectedEvents/{eventId} {
      allow get: if isOwner(resource.data);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }
    
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}