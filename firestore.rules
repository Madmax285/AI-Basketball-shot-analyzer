rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Checks if the document's userId matches the authenticated user's UID.
     */
    function isOwner(data) {
      return isAuthenticated()
        && data.get('userId', '') == request.auth.uid;
    }

    // =========================================================
    // USER-CENTRIC COLLECTIONS
    // =========================================================

    match /analysisSessions/{sessionId} {
      // Allow list (queries) only if filtered by the user's own UID
      allow list: if isAuthenticated() && request.query.userId == request.auth.uid;
      
      // Allow single document get and modifications only if the user is the owner
      allow get, update, delete: if isOwner(resource.data);
      
      // Allow creation only if the userId matches the authenticated user
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /shotResults/{shotId} {
      allow list: if isAuthenticated() && request.query.userId == request.auth.uid;
      allow get, update, delete: if isOwner(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /detectedEvents/{eventId} {
      allow list: if isAuthenticated() && request.query.userId == request.auth.uid;
      allow get, update, delete: if isOwner(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // =========================================================
    // SYSTEM METADATA
    // =========================================================

    match /system/{document=**} {
      // Allow read/write for any authenticated user to enable demo data seeding and global metadata.
      allow read, write: if isAuthenticated();
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}